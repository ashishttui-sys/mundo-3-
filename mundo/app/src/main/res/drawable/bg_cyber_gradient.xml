<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#020B16"
                android:centerColor="#03162A"
                android:endColor="#000000" />
        </shape>
    </item>
    <item android:top="-180dp" android:left="-160dp" android:right="120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerColor="#3329E3FF"
                android:endColor="#0029E3FF" />
        </shape>
    </item>
    <item android:bottom="-220dp" android:right="-140dp" android:left="80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:centerColor="#1F00BFFF"
                android:endColor="#0000BFFF" />
        </shape>
    </item>
</layer-list>
