<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_gradient"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/loginCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:background="@drawable/rounded_icon_bg"
            android:padding="5dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="TapaTap Loader"
            android:textColor="#FFFFFF"
            android:textSize="46sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVATION KEY"
                android:textColor="#8C97A8"
                android:textSize="12sp"
                android:letterSpacing="0.2" />

            <EditText
                android:id="@+id/userkey"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_neon"
                android:hint="Tapatap_trial_gyF2P1nB"
                android:text="Tapatap_trial_gyF2P1nB"
                android:paddingHorizontal="20dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8C97A8"
                android:textSize="17sp" />

            <Button
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_sky"
                android:text="LOGIN"
                android:textAllCaps="true"
                android:textColor="#020B16"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/GetKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/paste"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_content_paste"
                    android:tint="#29E3FF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="PASTE KEY"
                    android:textColor="#29E3FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp"
        android:text="System Ready"
        android:textColor="#8C97A8"
        android:letterSpacing="0.25"
        android:textSize="11sp" />
</RelativeLayout>
